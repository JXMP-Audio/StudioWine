+/* Command written in front of the arguments of Exec= lines: "wine", or the value of
+ * STUDIOWINE_MENU_EXEC (e.g. "\"/path/StudioWine.AppImage\" --wine"), which StudioWine
+ * sets so that menu entries and URL handlers work without a "wine" on the host PATH. */
+static const char *wine_exec_command(void)
+{
+    static const char *cmd;
+    const WCHAR *env;
+    if (cmd) return cmd;
+    env = _wgetenv(L"STUDIOWINE_MENU_EXEC");
+    cmd = (env && *env) ? wchars_to_utf8_chars(env) : "wine";
+    return cmd;
+}
+
