# Build environment for StudioWine. glibc 2.35 is the oldest supported target.
FROM ubuntu:22.04

ARG LLVM_MINGW_URL
ARG LLVM_MINGW_SHA256
ARG NTSYNC_H_URL
ARG NTSYNC_H_SHA256
ARG RUST_VERSION

ENV DEBIAN_FRONTEND=noninteractive
RUN dpkg --add-architecture i386 && apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git xz-utils zstd unzip file binutils patchelf xvfb xauth \
        gcc g++ make flex bison pkg-config gettext \
        libx11-dev libxext-dev libxcursor-dev libxi-dev libxrandr-dev libxrender-dev \
        libxinerama-dev libxcomposite-dev libxfixes-dev libxkbcommon-dev \
        libfreetype-dev libfontconfig-dev libgnutls28-dev libgl-dev libegl-dev libosmesa6-dev \
        libvulkan-dev libpulse-dev libasound2-dev libdbus-1-dev libudev-dev \
        libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev \
        mono-mcs mono-utils python3 python3-fonttools python3-brotli fontconfig \
        fonts-liberation2 fonts-dejavu-core fonts-dejavu-extra fonts-noto-core \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL -o /tmp/llvm-mingw.tar.xz "$LLVM_MINGW_URL" \
    && echo "$LLVM_MINGW_SHA256  /tmp/llvm-mingw.tar.xz" | sha256sum -c - \
    && mkdir -p /opt/llvm-mingw \
    && tar -xJf /tmp/llvm-mingw.tar.xz -C /opt/llvm-mingw --strip-components=1 \
    && rm /tmp/llvm-mingw.tar.xz
ENV PATH=/opt/llvm-mingw/bin:$PATH

RUN curl -fsSL -o /usr/include/linux/ntsync.h "$NTSYNC_H_URL" \
    && echo "$NTSYNC_H_SHA256  /usr/include/linux/ntsync.h" | sha256sum -c -

ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal \
        --default-toolchain "$RUST_VERSION" --component clippy \
    && chmod -R a+rwX /opt/cargo /opt/rustup
